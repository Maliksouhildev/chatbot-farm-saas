# =====================================================================
# CHATBOT FARM SAAS - ENVIRONMENT CONFIGURATION (ALGERIA)
# =====================================================================

# 1. Domain & App URLs
NEXT_PUBLIC_APP_URL=https://chatbotfarm.dz
N8N_WEBHOOK_URL=https://n8n.chatbotfarm.dz/webhook/universal-omnichannel-router

# 2. Supabase (PostgreSQL & pgvector)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. AI Providers
# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your-gemini-api-key
# Groq is used for ultra-fast and free Whisper large-v3 audio transcription
GROQ_API_KEY=gsk_your-groq-api-key

# 4. WhatsApp & Omnichannel Gateway (Evolution API v2)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-secure-evolution-global-api-key

# 5. Algerian Payments (Chargily Pay v2 - EDAHABIA & CIB)
CHARGILY_SECRET_KEY=test_sk_your-chargily-secret-key
CHARGILY_API_URL=https://pay.chargily.net/test/api/v2

# 6. Database (Self-hosted Docker Postgres)
POSTGRES_PASSWORD=super-secret-postgres-password-123
