{
	"name": "n8n-atom-v3",
	"displayName": "n8n Atom",
	"description": "World's first n8n client that manage workflow collections inside VSCode/Cursor/Antigravity",
	"version": "3.25.73",
	"private": true,
	"workspaces": [
		"src/workspaces/*"
	],
	"icon": "icons/n8n-logo.png",
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": [
		"Testing",
		"Programming Languages",
		"Other"
	],
	"author": "atom8n",
	"license": "MIT",
	"activationEvents": [
		"onCustomEditor:n8n.varEditor",
		"onCustomEditor:n8n.apiEditor",
		"workspaceContains:*.n8n"
	],
	"publisher": "atom8n",
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "n8n.newRequest",
				"category": "N8n",
				"title": "New Request"
			},
			{
				"command": "n8n.openHistory",
				"category": "N8n",
				"title": "Open History"
			},
			{
				"command": "n8n.openWorkspaces",
				"category": "N8n",
				"title": "Open Workspaces"
			},
			{
				"command": "n8n.switchToFork",
				"category": "N8n",
				"title": "Switch to Fork"
			}
		],
		"keybindings": [
			{
				"command": "n8n.newRequest",
				"key": "ctrl+n",
				"when": "n8n.apiEditorFocus || n8n.sidebarFocus"
			},
			{
				"command": "n8n.openHistory",
				"key": "ctrl+h",
				"when": "n8n.apiEditorFocus || n8n.sidebarFocus"
			},
			{
				"command": "n8n.openWorkspaces",
				"key": "ctrl+w",
				"when": "n8n.apiEditorFocus || n8n.sidebarFocus"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "n8n",
					"title": "N8n",
					"icon": "icons/n8n-logo.png"
				}
			]
		},
		"views": {
			"n8n": [
				{
					"type": "webview",
					"id": "n8n.collectionMenu",
					"name": "N8n",
					"contextualTitle": "N8n"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "n8n.varEditor",
				"displayName": "N8n Environments",
				"selector": [
					{
						"filenamePattern": "*.thorenv"
					}
				],
				"priority": "default"
			},
			{
				"viewType": "n8n.apiEditor",
				"displayName": "N8n",
				"selector": [
					{
						"filenamePattern": "*.n8n"
					}
				],
				"priority": "default"
			}
		],
		"languages": [
			{
				"id": "n8n",
				"extensions": [
					".n8n"
				],
				"aliases": [
					"N8N",
					"n8n"
				],
				"icon": {
					"light": "icons/n8n-logo.png",
					"dark": "icons/n8n-logo.png"
				}
			},
			{
				"id": "var",
				"extensions": [
					".thorenv"
				],
				"aliases": [
					"THORENV",
					"thorenv"
				],
				"icon": {
					"light": "icons/thor-avatar.png",
					"dark": "icons/thor-avatar.png"
				}
			}
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/khanh-atom/n8n-atom"
	},
	"scripts": {
		"patch-editor-ui-tree-sitter": "node scripts/patch-editor-ui-tree-sitter.mjs",
		"bump:version": "node .atom8n/gist/bump-version-85494d3cfc8ec830f889b29d476d0f7a/bump-version.mjs",
		"publish": "npm run patch-editor-ui-tree-sitter && npm run bump:version && npx -y ovsx publish",
		"publish-vsce": "node scripts/publish-vsce.mjs",
		"package": "npm run patch-editor-ui-tree-sitter && npx -y @vscode/vsce package",
		"ws-apit-build": "npm --prefix ./src/workspaces/api-tester-webview run build",
		"ws-apit-dev": "npm --prefix ./src/workspaces/api-tester-webview run dev",
		"ws-apic-build": "npm --prefix ./src/workspaces/API-Client-VSCode-Extension run build",
		"ws-apic-dev": "npm --prefix ./src/workspaces/API-Client-VSCode-Extension run dev",
		"main-build": "node node_modules/webpack-cli/bin/cli.js --mode production --devtool hidden-source-map",
		"build": "npm run ws-apit-build && npm run ws-apic-build && npm run main-build",
		"dev": "concurrently \"webpack --watch\" \"npm run ws-apic-dev\" \"npm run ws-apit-dev\"",
		"watch": "npm run patch-editor-ui-tree-sitter && npm run dev",
		"compile-tests": "tsc -p . --outDir out",
		"compile": "npm --prefix ../api-tester-webview run build && webpack",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"start": "concurrently \"webpack --watch\"  \"cd ../api-tester-webview && npm start\""
	},
	"devDependencies": {
		"@tabler/icons": "^1.46.0",
		"@types/glob": "^7.2.0",
		"@types/http-proxy": "^1.17.17",
		"@types/mocha": "^9.1.1",
		"@types/node": "16.x",
		"@types/vscode": "^1.70.0",
		"@typescript-eslint/eslint-plugin": "^5.31.0",
		"@typescript-eslint/parser": "^5.31.0",
		"@vscode/test-electron": "^2.1.5",
		"concurrently": "7.3.0",
		"eslint": "^8.20.0",
		"glob": "^8.0.3",
		"lerna": "^8.1.6",
		"mocha": "^10.0.0",
		"terser-webpack-plugin": "^5.3.6",
		"ts-loader": "^9.3.1",
		"typescript": "^4.7.4",
		"webpack": "^5.74.0",
		"webpack-cli": "^4.10.0"
	},
	"dependencies": {
		"@emotion/react": "^11.13.0",
		"@emotion/styled": "^11.13.0",
		"@lexical/react": "^0.17.1",
		"@mdxeditor/editor": "^3.14.0",
		"@mui/icons-material": "^5.16.4",
		"@mui/material": "^5.16.4",
		"axios": "^0.27.2",
		"classnames": "^2.5.1",
		"content-disposition": "^0.5.4",
		"curl-to-postmanv2": "^1.8.1",
		"curlconverter": "^3.21.0",
		"http-proxy": "^1.18.1",
		"openapi-to-postmanv2-atom8n": "^5.3.4",
		"emoji-datasource-facebook": "^15.1.2",
		"iconv-lite": "^0.6.3",
		"jotai": "^2.9.0",
		"lexical": "^0.17.1",
		"mime-types": "^2.1.35",
		"react-frame-component": "^5.2.7",
		"react-markdown": "^9.0.1",
		"react-split": "^2.0.14",
		"react-tippy": "^1.4.0",
		"react-use": "^17.5.1",
		"slate": "^0.103.0",
		"slate-history": "^0.100.0",
		"slate-react": "^0.107.1"
	},
	"resolutions": {
		"@monaco-editor/loader": "1.4.0"
	},
	"volta": {
		"node": "22.17.1",
		"yarn": "1.19.2",
		"npm": "10.2.3"
	},
	"__metadata": {
		"installedTimestamp": 1780338260941,
		"targetPlatform": "universal",
		"size": 81346755
	}
}