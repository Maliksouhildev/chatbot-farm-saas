    {
      "parameters": {
        "jsCode": "let root = $input.item.json.data?.xdt_shortcode_media || $input.item.json;\n\n// 1. EXTRAIRE LES STATS DU REEL (Mode blindé)\nlet owner = root.owner?.username || \"Unknown\";\nlet views = root.video_view_count || root.view_count || 0;\nlet plays = root.video_play_count || root.play_count || 0;\nlet likes = root.edge_media_preview_like?.count || root.like_count || 0;\nlet caption = root.edge_media_to_caption?.edges?.[0]?.node?.text || root.caption?.text || root.caption || \"No caption\";\n\nlet reelStats = `Owner: @${owner} | Views: ${views} | Plays: ${plays} | Likes: ${likes}\\nCaption: ${caption}`;\n\n// 2. EXTRAIRE JUSQU'À 25 COMMENTAIRES (Recherche multi-chemins)\n// On cherche dans \"parent_comment\", \"preview_comment\", ou directement \"comments\"\nlet commentsData = root.edge_media_to_parent_comment?.edges || root.edge_media_preview_comment?.edges || root.comments || [];\nlet topComments = [];\nlet limit = Math.min(commentsData.length, 25);\n\nfor (let i = 0; i < limit; i++) {\n    // Gère la structure GraphQL (\"node\") ET la structure REST classique\n    let c = commentsData[i].node || commentsData[i];\n    if (!c) continue;\n    \n    let text = c.text || c.comment_text || \"\";\n    let username = c.owner?.username || c.user?.username || \"user\";\n    let cLikes = c.edge_liked_by?.count || c.like_count || c.comment_like_count || 0;\n    \n    let commentStr = `[${cLikes} likes] ${username}: \"${text}\"`;\n    \n    // Extraire les réponses\n    let repliesData = c.edge_threaded_comments?.edges || c.replies || [];\n    let replyLimit = Math.min(repliesData.length, 3);\n    for (let j = 0; j < replyLimit; j++) {\n        let r = repliesData[j].node || repliesData[j];\n        if(!r) continue;\n        let rText = r.text || r.comment_text || \"\";\n        let rUser = r.owner?.username || r.user?.username || \"user\";\n        commentStr += `\\n   -> Reply by ${rUser}: \"${rText}\"`;\n    }\n    topComments.push(commentStr);\n}\n\n// 3. PRÉPARER LA SORTIE\nlet finalContext = topComments.length > 0 ? topComments.join(\"\\n\\n\") : \"No comments found.\";\nlet download_url = root.video_url || root.display_url || root.display_resources?.[0]?.src || \"\";\n\n// Ajouter au JSON\nlet out = $input.item.json;\nout.reel_stats = reelStats;\nout.community_context = finalContext;\nout.extracted_caption = caption;\nout.download_url = download_url;\n\nreturn { json: out };"
      },
