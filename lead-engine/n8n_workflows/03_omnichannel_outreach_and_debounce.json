      },
      "id": "http-email-dispatch",
      "name": "Dispatch Email & Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1720, 580]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
        "text": "=🚀 *OUTREACH DISPATCHED!*\\n\\n*Lead:* {{ $('Resolve Target Channel & Recipient').first().json.name }}\\n*Company:* {{ $('Resolve Target Channel & Recipient').first().json.company_name }}\\n*Channel:* `{{ $('Resolve Target Channel & Recipient').first().json.channel }}`\\n*Recipient:* `{{ $('Resolve Target Channel & Recipient').first().json.recipient }}`\\n*Debounce:* 14 Days Active Cooldown",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notify-sent",
      "name": "Notify Admin Outreach Sent",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2000, 420],
