            "index": 0
          }
        ]
      ]
    },
    "Action == Approve?": {
      "main": [
        [
          {
            "node": "Set Lead Approved in DB",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set Lead Rejected in DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Lead Approved in DB": {
      "main": [
        [
          {
