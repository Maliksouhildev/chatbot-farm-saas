            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Lead Rejected in DB": {
      "main": [
        [
          {
            "node": "Update Card Status In-Place",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
