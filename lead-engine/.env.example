# =============================================================================
# Lead Engine Environment Configuration
# Copy this file to .env before starting containers: `cp .env.example .env`
# =============================================================================

# -----------------------------------------------------------------------------
# 1. HOST PORT MAPPINGS (Prevents port collisions on Windows 11 host)
# -----------------------------------------------------------------------------
HOST_POSTGRES_PORT=5434
HOST_REDIS_PORT=6381
HOST_N8N_PORT=5679
HOST_HARVESTERS_PORT=8000

# -----------------------------------------------------------------------------
# 2. POSTGRESQL & REDIS INTERNAL CONFIGURATION
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_me
POSTGRES_DB=lead_engine
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# 3. N8N ORCHESTRATION ENGINE
# -----------------------------------------------------------------------------
# Generate a 32-character random hex string for N8N_ENCRYPTION_KEY
N8N_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90
# Tunnel URL generated by scripts/start_tunnel.ps1 (Must end with trailing slash)
WEBHOOK_URL=http://localhost:5679/
GENERIC_TIMEZONE=Africa/Algiers

# -----------------------------------------------------------------------------
# 3. REDDIT ACTIVE INTENT (PRAW OAUTH2)
# Register script application at: https://www.reddit.com/prefs/apps
# -----------------------------------------------------------------------------
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=python:lead-engine-b2b:v1.0 (by /u/your_reddit_username)
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDITS=n8n,automation,nocode,Entrepreneur,smallbusiness,forhire,freelance_forhire,SaaS,algeria

# -----------------------------------------------------------------------------
# 4. TELEGRAM MTPROTO (TELETHON LISTENER)
# Obtain API ID & Hash from: https://my.telegram.org/apps
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_hex
TELEGRAM_PHONE=+213555000000
TELEGRAM_TARGET_GROUPS=algeria_ecommerce,dz_freelancers,n8n_community,saas_founders

# -----------------------------------------------------------------------------
# 5. TELEGRAM HUMAN-IN-THE-LOOP (HITL) APPROVAL BOT
# Create bot via @BotFather and obtain your numeric chat ID via @userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ADMIN_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# 6. SERPER.DEV (GOOGLE DORKS & GMAPS AUDITOR)
# Free 2,500 queries at: https://serper.dev
# -----------------------------------------------------------------------------
SERPER_API_KEY=your_serper_dev_api_key

# -----------------------------------------------------------------------------
# 7. ARTIFICIAL INTELLIGENCE SCORING (OPENAI / GEMINI)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 8. OMNICHANNEL OUTREACH DISPATCH PROVIDERS
# WhatsApp: Evolution API, Baileys, or GreenAPI webhook
# Email: SMTP or Resend API
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key_token
EVOLUTION_INSTANCE_NAME=lead_dispatch
WHATSAPP_API_URL=http://localhost:8080/message/sendText
WHATSAPP_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM_EMAIL=your_email@gmail.com

# -----------------------------------------------------------------------------
# 9. GOOGLE SHEETS MASTER SYNC (PHASE 4 MIDNIGHT BATCH)
# Google Cloud Console Service Account with Google Sheets API enabled
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=1A2B3C4D5E6F7G8H9I0J_your_spreadsheet_id
GOOGLE_SHEETS_TAB_NAME=Master Leads
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=lead-engine-sync@your-project.iam.gserviceaccount.com

SMTP_PASS=
